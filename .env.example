# Copy to .env.local and fill in. See SETUP.md for where each value comes from.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Embeddings and reranking: "voyage" (default) or "openai"
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
# OPENAI_API_KEY=

# Public URL used for OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: raises the Semantic Scholar rate limit
# SEMANTIC_SCHOLAR_API_KEY=

# Optional: account used by `npm run eval`
# EVAL_USER_EMAIL=
# EVAL_USER_PASSWORD=
